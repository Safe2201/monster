<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Monsterstemmen</title>
<style>
:root {
  --bg: #0e1410;
  --surface: #17211a;
  --surface-2: #1f2c23;
  --text: #e8f0e4;
  --muted: #8fa393;
  --accent: #b6ff3c;
  --accent-ink: #0e1410;
  --danger: #ff5a4d;
  --line: #2b3b30;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  color-scheme: dark;
}
@media (prefers-color-scheme: light) {
  :root:not([data-theme="dark"]) {
    --bg: #eef3e8; --surface: #ffffff; --surface-2: #e3ecd9; --text: #15201a;
    --muted: #5a6b5f; --accent: #2f6b00; --accent-ink: #ffffff; --danger: #c0392b; --line: #c9d6bd;
    color-scheme: light;
  }
}
:root[data-theme="light"] {
  --bg: #eef3e8; --surface: #ffffff; --surface-2: #e3ecd9; --text: #15201a;
  --muted: #5a6b5f; --accent: #2f6b00; --accent-ink: #ffffff; --danger: #c0392b; --line: #c9d6bd;
  color-scheme: light;
}
html { scroll-padding-top: env(safe-area-inset-top, 0px); }
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font-family: "Trebuchet MS", "Segoe UI", system-ui, sans-serif;
  line-height: 1.45; min-height: 100vh;
}
main { max-width: 520px; margin: 0 auto; padding: 20px 18px 40px; }
h1 {
  font-family: Impact, "Arial Narrow Bold", "Haettenschweiler", sans-serif;
  font-weight: 400; font-size: 44px; letter-spacing: .5px; margin: 6px 0 2px;
  line-height: 1;
}
.sub { color: var(--muted); margin: 0 0 18px; font-size: 15px; }
.stage {
  background: var(--surface); border: 1px solid var(--line); border-radius: 22px;
  padding: 18px; display: flex; flex-direction: column; align-items: center; gap: 14px;
}
#power {
  width: 150px; height: 150px; border-radius: 50%; border: 0; cursor: pointer;
  background: var(--accent); color: var(--accent-ink);
  font: 400 24px Impact, "Arial Narrow Bold", sans-serif; letter-spacing: .5px;
  box-shadow: 0 0 0 8px var(--surface-2);
  transition: transform .12s, box-shadow .2s;
}
#power:active { transform: scale(.96); }
#power.on { background: var(--danger); color: #fff; box-shadow: 0 0 0 8px var(--surface-2), 0 0 40px 6px color-mix(in srgb, var(--danger) 55%, transparent); }
#power:focus-visible, .chip:focus-visible, input:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
.meter { width: 100%; height: 10px; background: var(--surface-2); border-radius: 6px; overflow: hidden; }
#bar { height: 100%; width: 0%; background: var(--accent); transition: width .05s linear; }
#status { font-size: 14px; color: var(--muted); min-height: 20px; text-align: center; }
#status.err { color: var(--danger); }
h2 { font-size: 17px; margin: 24px 0 10px; font-weight: 700; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  border: 1px solid var(--line); background: var(--surface); color: var(--text);
  padding: 10px 14px; border-radius: 999px; font-size: 15px; cursor: pointer;
}
.chip[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 700; }
.ctl { margin: 14px 0; }
.ctl label { display: flex; justify-content: space-between; font-size: 15px; margin-bottom: 6px; }
.ctl output { color: var(--muted); font-variant-numeric: tabular-nums; }
input[type=range] { width: 100%; accent-color: var(--accent); height: 28px; }
select { width: 100%; padding: 12px; font-size: 15px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); color: var(--text); }
.tip {
  margin-top: 24px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line);
  border-radius: 14px; font-size: 14px; color: var(--muted);
}
.tip b { color: var(--text); }
</style>
</head>
<body>
<main>
  <h1>Monsterstemmen</h1>
  <p class="sub">Tal i mikrofonen. Stemmen ændres live og kommer ud af højttaleren.</p>

  <section class="stage">
    <button id="power" type="button">START</button>
    <div class="meter" aria-hidden="true"><div id="bar"></div></div>
    <div id="status" role="status">Tryk START og tillad mikrofonen.</div>
  </section>

  <h2>Mikrofon</h2>
  <select id="mic" aria-label="Vælg mikrofon"><option value="">Standardmikrofon</option></select>

  <h2>Stemme</h2>
  <div class="chips" id="chips"></div>

  <h2>Finjuster</h2>
  <div class="ctl"><label for="pitch">Tonehøjde <output id="o-pitch"></output></label>
    <input id="pitch" type="range" min="-1" max="0.6" step="0.01"></div>
  <div class="ctl"><label for="growl">Knurren <output id="o-growl"></output></label>
    <input id="growl" type="range" min="0" max="1" step="0.01"></div>
  <div class="ctl"><label for="ringf">Knurre-hastighed <output id="o-ringf"></output></label>
    <input id="ringf" type="range" min="10" max="200" step="1"></div>
  <div class="ctl"><label for="drive">Snavs <output id="o-drive"></output></label>
    <input id="drive" type="range" min="0" max="1" step="0.01"></div>
  <div class="ctl"><label for="bass">Bas <output id="o-bass"></output></label>
    <input id="bass" type="range" min="0" max="18" step="0.5"></div>
  <div class="ctl"><label for="reverb">Hule-ekko <output id="o-reverb"></output></label>
    <input id="reverb" type="range" min="0" max="1" step="0.01"></div>
  <div class="ctl"><label for="vol">Lydstyrke <output id="o-vol"></output></label>
    <input id="vol" type="range" min="0" max="1.5" step="0.01"></div>

  <div class="tip">
    <b>Undgå hylende feedback:</b> brug høretelefoner, eller hold mikrofonen langt fra højttaleren og skru ned for lydstyrken.
    Til en rigtig højttaler: tilslut den via Bluetooth eller kabel til din telefon.
  </div>
</main>

<script>
(function () {
  var PRESETS = {
    "Front Man":    { pitch: -0.55, growl: 0.22, ringf: 60,  drive: 0.35, bass: 8,  reverb: 0.15 },
    "Monster":      { pitch: -0.75, growl: 0.35, ringf: 35,  drive: 0.5,  bass: 10, reverb: 0.25 },
    "Dæmon":        { pitch: -1,    growl: 0.6,  ringf: 55,  drive: 0.7,  bass: 12, reverb: 0.45 },
    "Kæmpetrold":   { pitch: -0.9,  growl: 0.15, ringf: 25,  drive: 0.35, bass: 14, reverb: 0.5 },
    "Robot-uhyre":  { pitch: -0.4,  growl: 0.9,  ringf: 120, drive: 0.3,  bass: 4,  reverb: 0.2 },
    "Gremlin":      { pitch: 0.45,  growl: 0.25, ringf: 80,  drive: 0.4,  bass: 0,  reverb: 0.1 }
  };
  var state = Object.assign({ vol: 0.8 }, PRESETS["Front Man"]);
  var fmt = {
    pitch: function (v) { return v < 0 ? "dybere" : v > 0 ? "højere" : "normal"; },
    growl: pct, ringf: function (v) { return v + " Hz"; }, drive: pct,
    bass: function (v) { return "+" + v + " dB"; }, reverb: pct, vol: pct
  };
  function pct(v) { return Math.round(v * 100) + "%"; }

  var $ = function (id) { return document.getElementById(id); };
  var ctx, stream, src, graph = null, running = false, rafId = null;

  /* ---------- UI ---------- */
  var chipsEl = $("chips");
  Object.keys(PRESETS).forEach(function (name) {
    var b = document.createElement("button");
    b.type = "button"; b.className = "chip"; b.textContent = name;
    b.setAttribute("aria-pressed", name === "Front Man" ? "true" : "false");
    b.addEventListener("click", function () {
      Object.assign(state, PRESETS[name]);
      Array.prototype.forEach.call(chipsEl.children, function (c) {
        c.setAttribute("aria-pressed", c === b ? "true" : "false");
      });
      syncSliders(); applyParams();
    });
    chipsEl.appendChild(b);
  });
  ["pitch", "growl", "ringf", "drive", "bass", "reverb", "vol"].forEach(function (k) {
    $(k).addEventListener("input", function () {
      state[k] = parseFloat($(k).value);
      $("o-" + k).textContent = fmt[k](state[k]);
      Array.prototype.forEach.call(chipsEl.children, function (c) { c.setAttribute("aria-pressed", "false"); });
      applyParams();
    });
  });
  function syncSliders() {
    ["pitch", "growl", "ringf", "drive", "bass", "reverb", "vol"].forEach(function (k) {
      $(k).value = state[k]; $("o-" + k).textContent = fmt[k](state[k]);
    });
  }
  syncSliders();

  function setStatus(msg, err) { var s = $("status"); s.textContent = msg; s.className = err ? "err" : ""; }

  /* ---------- Audio helpers ---------- */
  function driveCurve(amount) {
    var n = 2048, c = new Float32Array(n), k = 1 + amount * 12;
    for (var i = 0; i < n; i++) { var x = i * 2 / n - 1; c[i] = Math.tanh(x * k) / Math.tanh(k) * 0.9; }
    return c;
  }
  function impulse(c, secs, decay) {
    var len = Math.floor(c.sampleRate * secs), buf = c.createBuffer(2, len, c.sampleRate);
    for (var ch = 0; ch < 2; ch++) {
      var d = buf.getChannelData(ch);
      for (var i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, decay);
    }
    return buf;
  }

  /* Pitch shifter af to modulerede delay-linjer med crossfade */
  function makePitchShifter(c) {
    var BUF = 0.1, FADE = 0.05;
    var input = c.createGain(), output = c.createGain();
    var len = Math.round(BUF * c.sampleRate);

    var fadeBuf = c.createBuffer(1, len, c.sampleRate), fp = fadeBuf.getChannelData(0), fl = Math.round(FADE * c.sampleRate);
    for (var i = 0; i < len; i++) {
      fp[i] = i < fl ? Math.sqrt(i / fl) : (i >= len - fl ? Math.sqrt(1 - (i - (len - fl)) / fl) : 1);
    }
    var downBuf = c.createBuffer(1, len, c.sampleRate), upBuf = c.createBuffer(1, len, c.sampleRate);
    var dp = downBuf.getChannelData(0), up = upBuf.getChannelData(0);
    for (var j = 0; j < len; j++) { dp[j] = j / len; up[j] = (len - j) / len; }

    function src(buf) { var s = c.createBufferSource(); s.buffer = buf; s.loop = true; return s; }
    var mod1 = src(downBuf), mod2 = src(downBuf), mod3 = src(upBuf), mod4 = src(upBuf);
    var m1g = c.createGain(), m2g = c.createGain(), m3g = c.createGain(), m4g = c.createGain();
    var modGain1 = c.createGain(), modGain2 = c.createGain();
    modGain1.gain.value = modGain2.gain.value = 0.5 * BUF;
    var d1 = c.createDelay(1), d2 = c.createDelay(1);
    d1.delayTime.value = 0; d2.delayTime.value = 0;
    mod1.connect(m1g); m1g.connect(modGain1); mod3.connect(m3g); m3g.connect(modGain1); modGain1.connect(d1.delayTime);
    mod2.connect(m2g); m2g.connect(modGain2); mod4.connect(m4g); m4g.connect(modGain2); modGain2.connect(d2.delayTime);

    var f1 = src(fadeBuf), f2 = src(fadeBuf), mix1 = c.createGain(), mix2 = c.createGain();
    mix1.gain.value = 0; mix2.gain.value = 0;
    f1.connect(mix1.gain); f2.connect(mix2.gain);
    input.connect(d1); d1.connect(mix1); mix1.connect(output);
    input.connect(d2); d2.connect(mix2); mix2.connect(output);

    var t = c.currentTime + 0.05, t2 = t + BUF - FADE;
    mod1.start(t); mod2.start(t2); mod3.start(t); mod4.start(t2); f1.start(t); f2.start(t2);

    function setPitch(m) {
      var down = m < 0 ? -m : 0, upv = m > 0 ? m : 0, now = c.currentTime;
      [[m1g, down], [m2g, down], [m3g, upv], [m4g, upv]].forEach(function (p) { p[0].gain.setTargetAtTime(p[1], now, 0.02); });
    }
    return { input: input, output: output, setPitch: setPitch,
      stop: function () { [mod1, mod2, mod3, mod4, f1, f2].forEach(function (s) { try { s.stop(); } catch (e) {} }); } };
  }

  /* ---------- Byg kæden ---------- */
  function build() {
    var hp = ctx.createBiquadFilter(); hp.type = "highpass"; hp.frequency.value = 70;
    var ps = makePitchShifter(ctx);

    // ringmodulator (knurren)
    var ringIn = ctx.createGain(), ringMul = ctx.createGain(); ringMul.gain.value = 0;
    var osc = ctx.createOscillator(); osc.type = "sine"; osc.start();
    osc.connect(ringMul.gain);
    var wetRing = ctx.createGain(), dryRing = ctx.createGain(), sum = ctx.createGain();
    ps.output.connect(dryRing); ps.output.connect(ringIn); ringIn.connect(ringMul); ringMul.connect(wetRing);
    dryRing.connect(sum); wetRing.connect(sum);

    var shaper = ctx.createWaveShaper(); shaper.oversample = "2x";
    var shelf = ctx.createBiquadFilter(); shelf.type = "lowshelf"; shelf.frequency.value = 220;
    var growlEq = ctx.createBiquadFilter(); growlEq.type = "peaking"; growlEq.frequency.value = 450; growlEq.Q.value = 1.2; growlEq.gain.value = 5;
    var lp = ctx.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 6000;
    var comp = ctx.createDynamicsCompressor(); comp.threshold.value = -24; comp.ratio.value = 6;

    var conv = ctx.createConvolver(); conv.buffer = impulse(ctx, 1.8, 2.6);
    var wetRev = ctx.createGain(), dryRev = ctx.createGain();
    var master = ctx.createGain(); var analyser = ctx.createAnalyser(); analyser.fftSize = 512;

    src.connect(hp); hp.connect(ps.input);
    sum.connect(shaper); shaper.connect(shelf); shelf.connect(growlEq); growlEq.connect(lp); lp.connect(comp);
    comp.connect(dryRev); comp.connect(conv); conv.connect(wetRev);
    dryRev.connect(master); wetRev.connect(master); master.connect(analyser); master.connect(ctx.destination);

    graph = { ps: ps, osc: osc, wetRing: wetRing, dryRing: dryRing, shaper: shaper, shelf: shelf,
      wetRev: wetRev, dryRev: dryRev, master: master, analyser: analyser };
    applyParams(true);
  }

  function applyParams(instant) {
    if (!graph) return;
    var now = ctx.currentTime, tc = instant ? 0.001 : 0.03;
    graph.ps.setPitch(state.pitch);
    graph.osc.frequency.setTargetAtTime(state.ringf, now, tc);
    graph.wetRing.gain.setTargetAtTime(state.growl * 1.4, now, tc);
    graph.dryRing.gain.setTargetAtTime(1 - state.growl * 0.6, now, tc);
    graph.shaper.curve = driveCurve(state.drive);
    graph.shelf.gain.setTargetAtTime(state.bass, now, tc);
    graph.wetRev.gain.setTargetAtTime(state.reverb * 0.9, now, tc);
    graph.dryRev.gain.setTargetAtTime(1 - state.reverb * 0.3, now, tc);
    graph.master.gain.setTargetAtTime(state.vol, now, tc);
  }

  function meter() {
    var a = graph.analyser, d = new Uint8Array(a.fftSize);
    (function loop() {
      a.getByteTimeDomainData(d);
      var peak = 0; for (var i = 0; i < d.length; i++) peak = Math.max(peak, Math.abs(d[i] - 128));
      $("bar").style.width = Math.min(100, peak / 128 * 140) + "%";
      rafId = requestAnimationFrame(loop);
    })();
  }

  /* ---------- Start / stop ---------- */
  async function start() {
    try {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        setStatus("Din browser kan ikke bruge mikrofonen her. Åbn siden direkte i Safari eller Chrome.", true); return;
      }
      var micId = $("mic").value;
      var a = { echoCancellation: true, noiseSuppression: true, autoGainControl: false };
      if (micId) a.deviceId = { exact: micId };
      stream = await navigator.mediaDevices.getUserMedia({ audio: a });
      listMics();
      keepAwake();
      var AC = window.AudioContext || window.webkitAudioContext;
      ctx = new AC({ latencyHint: "interactive" });
      await ctx.resume();
      src = ctx.createMediaStreamSource(stream);
      build(); meter();
      running = true;
      $("power").textContent = "STOP"; $("power").classList.add("on");
      setStatus("Live. Tal nu. Brug høretelefoner for at undgå feedback.");
    } catch (e) {
      setStatus(e && e.name === "NotAllowedError"
        ? "Mikrofonen er blokeret. Tillad den i browserens indstillinger, og prøv igen."
        : "Kunne ikke starte lyden. Åbn siden direkte i Safari eller Chrome og prøv igen.", true);
    }
  }
  async function listMics() {
    try {
      var cur = $("mic").value, devs = await navigator.mediaDevices.enumerateDevices(), sel = $("mic");
      sel.innerHTML = '<option value="">Standardmikrofon</option>';
      devs.filter(function (d) { return d.kind === "audioinput"; }).forEach(function (d, i) {
        var o = document.createElement("option"); o.value = d.deviceId;
        o.textContent = d.label || ("Mikrofon " + (i + 1)); sel.appendChild(o);
      });
      sel.value = cur;
    } catch (e) {}
  }
  $("mic").addEventListener("change", function () { if (running) { stop(); start(); } });

  var wakeLock = null;
  async function keepAwake() {
    try { if ("wakeLock" in navigator) wakeLock = await navigator.wakeLock.request("screen"); } catch (e) {}
  }
  document.addEventListener("visibilitychange", function () {
    if (document.visibilityState === "visible" && running) keepAwake();
  });

  function stop() {
    cancelAnimationFrame(rafId);
    if (wakeLock) { try { wakeLock.release(); } catch (e) {} wakeLock = null; }
    if (graph) { graph.ps.stop(); try { graph.osc.stop(); } catch (e) {} }
    if (stream) stream.getTracks().forEach(function (t) { t.stop(); });
    if (ctx) ctx.close();
    graph = null; running = false; $("bar").style.width = "0%";
    $("power").textContent = "START"; $("power").classList.remove("on");
    setStatus("Stoppet. Tryk START for at tale igen.");
  }
  $("power").addEventListener("click", function () { running ? stop() : start(); });
})();
</script>
</body>
</html>
